---
import BaseLayout from '../layouts/BaseLayout.astro';
import Comments from '../components/Comments.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../data/site';

const aboutItems = await getCollection('about');
const aboutEntry = aboutItems[0];
const { Content } = await aboutEntry.render();
---
<BaseLayout title={`关于 - ${siteConfig.title}`} description="关于这个博客">
  <article class="article">
    <div class="article-inner">
      <header class="article-header"><h1 class="article-title">关于</h1></header>
      <div class="hr-line"></div>
      <div class="article-entry">
        <Content />
      </div>
    </div>
  </article>
  <Comments />
</BaseLayout>
